rules_version = '2';

// =============================================================
// Settlo Firestore セキュリティルール（厳格版）
//   方針：ログインだけで全データ読み書き可、をやめる。
//   - users: プロフィールは相互参照が必要なので「読み=全ログインユーザー / 書き=本人のみ」
//   - transactions（金額・債権債務）: 当事者 or イベント参加者のみ
//   - events: 参加（招待コード検索）が必要なので読みは全ログインユーザー / 変更は参加者
//   - notifications: 受信者のみ読める / 作成は誰でも（承認・催促・拒否を送るため）
//   - friendRequests: 当事者（送信者/受信者）のみ
//   一致しないコレクションは既定で拒否（catch-all なし）。
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // 取引の当事者（債務者 paidById / 債権者 paidToId）か
    function isParty(data) {
      return isSignedIn()
        && (request.auth.uid == data.paidById || request.auth.uid == data.paidToId);
    }
    // 指定イベントの参加者か（eventId が無い取引では false）
    function isEventParticipant(eventId) {
      return isSignedIn()
        && eventId != null
        && exists(/databases/$(database)/documents/events/$(eventId))
        && request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participants;
    }

    // 「自分を参加者に1人足すだけ」の更新か（join）。
    // 他の項目を1つでも触っていたら false。既存の参加者を減らしていても false。
    function isSelfJoinOnly() {
      return resource.data.get('locked', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        && request.resource.data.participants.toSet()
             .difference(resource.data.participants.toSet())
           == [request.auth.uid].toSet()
        && resource.data.participants.toSet()
             .difference(request.resource.data.participants.toSet()).size() == 0;
    }

    // ---- ユーザープロフィール ----
    match /users/{uid} {
      // 1件ずつの読取りは許す（名前・写真を他の人の画面に出すため）
      allow get: if isSignedIn();
      // ⚠️ 2026-09-18 追加。
      //   まとめ取り（一覧）を無制限に許すと、ログインしていれば誰でも
      //   users を丸ごと引けてしまう。フレンド検索と招待の検索はどちらも
      //   limit(10) なので、上限のある問い合わせだけ通す。
      allow list: if isSignedIn() && request.query.limit <= 20;
      allow write: if isUser(uid);          // 自分のドキュメントのみ作成/更新/削除

      // 本人しか読めない置き場（通知トークンなど、他人に見せないもの）
      match /private/{docId} {
        allow read, write: if isUser(uid);
      }

      // フレンド一覧（承認時に相手側にも書くので、当事者2人なら可）
      match /friends/{friendUid} {
        allow read: if isUser(uid);
        allow write: if isUser(uid) || isUser(friendUid);
      }

      // ゴミ箱（削除したイベント・完了した決済の復元用・本人のみ）
      match /trash/{trashId} {
        allow read, write: if isUser(uid);
      }
    }

    // ---- 取引（金額・貸し借り）----
    match /transactions/{txId} {
      allow read:   if isParty(resource.data)
                      || isEventParticipant(resource.data.get('eventId', null));
      allow create: if isSignedIn()
                      && request.resource.data.get('eventSettlementPlanId', null) == null
                      && (request.auth.uid == request.resource.data.paidById
                          || request.auth.uid == request.resource.data.paidToId
                          || isEventParticipant(request.resource.data.get('eventId', null)));
      // 全員精算に予約された元取引は、途中で通常の精算・編集・削除を重ねない。
      // planIdの付与と解除、最終完了は認証を検証するCloud Functionsだけが行う。
      allow update: if resource.data.get('eventSettlementPlanId', null) == null
                      && request.resource.data.get('eventSettlementPlanId', null) == null
                      && (isParty(resource.data)
                          || isEventParticipant(resource.data.get('eventId', null)));
      allow delete: if resource.data.get('eventSettlementPlanId', null) == null
                      && (isParty(resource.data)
                          || isEventParticipant(resource.data.get('eventId', null)));
    }

    // ---- イベント全員分のまとめて精算 ----
    // 金額と元取引を同時に確定するため、クライアントからの書込みは許可しない。
    // 読取りは対象イベントの参加者だけ。作成・支払報告・受取確認はCloud Functions経由。
    match /eventSettlementPlans/{planId} {
      allow read: if isEventParticipant(resource.data.get('eventId', null));
      allow create, update, delete: if false;

      match /legs/{legId} {
        allow read: if isSignedIn()
          && exists(/databases/$(database)/documents/eventSettlementPlans/$(planId))
          && isEventParticipant(get(/databases/$(database)/documents/eventSettlementPlans/$(planId)).data.get('eventId', null));
        allow create, update, delete: if false;
      }
    }

    // ---- イベント ----
    match /events/{eventId} {
      allow read: if isSignedIn();          // 招待コード検索でjoinするため
      allow create: if isSignedIn()
                      && request.auth.uid in request.resource.data.participants
                      && request.resource.data.get('activeEventSettlementPlanId', null) == null
                      && request.resource.data.get('lastEventSettlementPlanId', null) == null;
      // 既存参加者の編集 or「自分を参加者に追加する更新（join）」を許可
      // 鍵付き（locked=true）のイベントは自分での追加を認めない＝リーダーの承認が必要
      //
      // ⚠️ 2026-09-18 修正。
      //   以前は「自分が参加者に入っていれば何でも書ける」だったため、参加していない人でも
      //   自分を足すのと同時に totalAmount・名前・他の参加者まで書き換えられた。
      //   さらに参加者になれば history と transactions も触れてしまう（金額が動く）。
      //   join は「participants に自分を1人足すだけ」に限定する。
      //   招待コードでの参加・招待からの参加・再参加は、どれも
      //   updateDoc(..., { participants: arrayUnion(自分) }) の1項目だけなので、これで通る。
      allow update: if isSignedIn()
                      && request.resource.data.get('activeEventSettlementPlanId', null)
                        == resource.data.get('activeEventSettlementPlanId', null)
                      && request.resource.data.get('lastEventSettlementPlanId', null)
                        == resource.data.get('lastEventSettlementPlanId', null)
                      && (resource.data.get('activeEventSettlementPlanId', null) == null
                          || request.resource.data.participants == resource.data.participants)
                      && (request.auth.uid in resource.data.participants
                          || isSelfJoinOnly());
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      // 立替履歴：そのイベントの参加者のみ
      match /history/{historyId} {
        allow read, write: if isSignedIn()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participants;
      }
    }

    // ---- 共有ゴミ箱（取引の削除/完了の控え・両当事者が見られる） ----
    match /trash/{trashId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
    }

    // ---- 通知 ----
    match /notifications/{notifId} {
      allow read:           if isSignedIn() && resource.data.toUserId == request.auth.uid;
      // ⚠️ 2026-09-18 修正。
      //   以前はログインしていれば誰でも、送信者を偽った通知を作れた。
      //   アプリ側は33か所すべて自分のUIDを入れているので、それを条件にする。
      //   Cloud Functions からの作成は管理者権限なのでこの条件を通る。
      allow create:         if isSignedIn()
                              && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.toUserId == request.auth.uid;
    }

    // ---- フレンド申請 ----
    match /friendRequests/{reqId} {
      allow read:           if isSignedIn()
                              && (resource.data.toId == request.auth.uid
                                  || resource.data.formId == request.auth.uid);
      allow create:         if isSignedIn();
      allow update, delete: if isSignedIn()
                              && (resource.data.toId == request.auth.uid
                                  || resource.data.formId == request.auth.uid);
    }

    // ---- 承認・拒否の履歴（本人のみ読める / 記録は相手側にも書くため create は誰でも） ----
    match /approvalHistory/{id} {
      allow read:           if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create:         if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- 会話スレッド（件ごとのメッセージ・その件の当事者のみ） ----
    match /threads/{threadId} {
      allow read:   if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      // ⚠️ 2026-09-18 修正。
      //   以前は「自分を participants に入れて更新すれば通る」ため、スレッドIDを知っていれば
      //   誰でも自分を足して会話を読めた。アプリ側に後から参加者を足す処理は無いので外す。
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read, create, update: if isSignedIn()
          && exists(/databases/$(database)/documents/threads/$(threadId))
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
      }
    }
  }
}
