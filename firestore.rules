rules_version = '2';

// =============================================================
// Settlo Firestore セキュリティルール（厳格版）
//   方針：ログインだけで全データ読み書き可、をやめる。
//   - users: プロフィールは相互参照が必要なので「読み=全ログインユーザー / 書き=本人のみ」
//   - transactions（金額・債権債務）: 当事者 or イベント参加者のみ
//   - events: 読み書きとも参加者のみ（招待コードの照合と参加は Cloud Functions の joinEvent が行う）
//   - notifications: 受信者のみ読める / 作成は誰でも（承認・催促・拒否を送るため）
//   - friendRequests: 当事者（送信者/受信者）のみ
//   一致しないコレクションは既定で拒否（catch-all なし）。
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // 取引の当事者（債務者 paidById / 債権者 paidToId）か
    function isParty(data) {
      return isSignedIn()
        && (request.auth.uid == data.paidById || request.auth.uid == data.paidToId);
    }
    // 指定イベントの参加者か（eventId が無い取引では false）
    function isEventParticipant(eventId) {
      return isSignedIn()
        && eventId != null
        && exists(/databases/$(database)/documents/events/$(eventId))
        && request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participants;
    }

    // ---- ユーザープロフィール ----
    match /users/{uid} {
      // 1件ずつの読取りは許す（名前・写真を他の人の画面に出すため）
      allow get: if isSignedIn();
      // ⚠️ 2026-09-18 追加。
      //   まとめ取り（一覧）を無制限に許すと、ログインしていれば誰でも
      //   users を丸ごと引けてしまう。フレンド検索と招待の検索はどちらも
      //   limit(10) なので、上限のある問い合わせだけ通す。
      allow list: if isSignedIn() && request.query.limit <= 20;
      allow write: if isUser(uid);          // 自分のドキュメントのみ作成/更新/削除

      // 本人しか読めない置き場（通知トークンなど、他人に見せないもの）
      match /private/{docId} {
        allow read, write: if isUser(uid);
      }

      // フレンド一覧
      // ⚠️ 2026-10-17 修正。
      //   以前は「当事者2人なら書ける」だったため、申請を送った側が相手の一覧へ自分を書き込めた
      //   （相手の同意なしにフレンドになれた）。承認は Cloud Functions（acceptFriendRequest）が
      //   申請を受け取った人を確かめて両方の一覧へ書く。画面から書けるのは自分の一覧だけ。
      //   相手の一覧から自分を消す（フレンド解除）は今までどおりできる。
      match /friends/{friendUid} {
        allow read: if isUser(uid);
        allow create, update: if isUser(uid);
        allow delete: if isUser(uid) || isUser(friendUid);
      }

      // ゴミ箱（削除したイベント・完了した決済の復元用・本人のみ）
      match /trash/{trashId} {
        allow read, write: if isUser(uid);
      }
    }

    // ---- 取引（金額・貸し借り）----
    match /transactions/{txId} {
      // ⚠️ 2026-10-17 追加（相手ごとのまとめ精算）。
      //   申請・承認・拒否は Cloud Functions（settlementBatch）が対象の取引全件・内訳・お知らせを1回で確定する。
      //   承認待ちのまとめ精算の取引は画面から直接書けず（完了にも未払いにもできない・消せない）、
      //   内訳（settlementBatch）は画面から付けたり書き換えたりできない。
      //   完了済みの取引を内訳ごと未精算へ戻す（当事者が合意した戻し）は今までどおりできる。
      function batchInProgress(data) {
        return data.get('settlementBatch', null) != null
          && data.get('status', 'unpaid') == 'awaiting_approval';
      }
      function keepsBatch() {
        return request.resource.data.get('settlementBatch', null) == null
          || request.resource.data.settlementBatch == resource.data.get('settlementBatch', null);
      }
      allow read:   if isParty(resource.data)
                      || isEventParticipant(resource.data.get('eventId', null));
      allow create: if isSignedIn()
                      && request.resource.data.get('eventSettlementPlanId', null) == null
                      && request.resource.data.get('settlementBatch', null) == null
                      && (request.auth.uid == request.resource.data.paidById
                          || request.auth.uid == request.resource.data.paidToId
                          || isEventParticipant(request.resource.data.get('eventId', null)));
      // 全員精算に予約された元取引は、途中で通常の精算・編集・削除を重ねない。
      // planIdの付与と解除、最終完了は認証を検証するCloud Functionsだけが行う。
      allow update: if resource.data.get('eventSettlementPlanId', null) == null
                      && request.resource.data.get('eventSettlementPlanId', null) == null
                      && !batchInProgress(resource.data)
                      && keepsBatch()
                      && (isParty(resource.data)
                          || isEventParticipant(resource.data.get('eventId', null)));
      allow delete: if resource.data.get('eventSettlementPlanId', null) == null
                      && !batchInProgress(resource.data)
                      && (isParty(resource.data)
                          || isEventParticipant(resource.data.get('eventId', null)));
    }

    // ---- 相手ごとのまとめ精算の台帳（同じ要求の再送を見分けるための記録）----
    // 書くのも読むのも Cloud Functions（settlementBatch）だけ。
    match /settlementRequests/{requestId} {
      allow read, write: if false;
    }

    // ---- イベント全員分のまとめて精算 ----
    // 金額と元取引を同時に確定するため、クライアントからの書込みは許可しない。
    // 読取りは対象イベントの参加者だけ。作成・支払報告・受取確認はCloud Functions経由。
    match /eventSettlementPlans/{planId} {
      allow read: if isEventParticipant(resource.data.get('eventId', null));
      allow create, update, delete: if false;

      match /legs/{legId} {
        allow read: if isSignedIn()
          && exists(/databases/$(database)/documents/eventSettlementPlans/$(planId))
          && isEventParticipant(get(/databases/$(database)/documents/eventSettlementPlans/$(planId)).data.get('eventId', null));
        allow create, update, delete: if false;
      }
    }

    // ---- イベント ----
    // ⚠️ 2026-10-17 修正。
    //   以前は「招待コード検索で参加するため」にログイン済みなら誰でも読めた。そのため公開デモの
    //   ゲストを含む誰でも、全イベントの名前・参加者・招待コード・総額を一覧でき、鍵なしのイベントへ入れた。
    //   招待コードの照合と参加は Cloud Functions（joinEvent）が行うので、読み取りは参加者だけに閉じる。
    //   一覧は「participants に自分を含む」条件の問い合わせだけが通る。無い文書の読み取りは中身が返らないので通す。
    match /events/{eventId} {
      allow get: if isSignedIn()
                   && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
                      && request.auth.uid in request.resource.data.participants
                      && request.resource.data.get('activeEventSettlementPlanId', null) == null
                      && request.resource.data.get('lastEventSettlementPlanId', null) == null;
      // 変更は参加者だけ。
      // ⚠️ 2026-10-17 修正。以前は「自分を参加者に1人足すだけの更新」を参加者でなくても許していた
      //   （招待コード参加のため）。参加は joinEvent が行うので、この抜け道は閉じた。
      allow update: if isSignedIn()
                      && request.resource.data.get('activeEventSettlementPlanId', null)
                        == resource.data.get('activeEventSettlementPlanId', null)
                      && request.resource.data.get('lastEventSettlementPlanId', null)
                        == resource.data.get('lastEventSettlementPlanId', null)
                      && (resource.data.get('activeEventSettlementPlanId', null) == null
                          || request.resource.data.participants == resource.data.participants)
                      && request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      // 立替履歴：そのイベントの参加者のみ
      match /history/{historyId} {
        allow read, write: if isSignedIn()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participants;
      }
    }

    // ---- 共有ゴミ箱（取引の削除/完了の控え・両当事者が見られる） ----
    match /trash/{trashId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
    }

    // ---- 通知 ----
    match /notifications/{notifId} {
      allow read:           if isSignedIn() && resource.data.toUserId == request.auth.uid;
      // ⚠️ 2026-09-18 修正。
      //   以前はログインしていれば誰でも、送信者を偽った通知を作れた。
      //   アプリ側は33か所すべて自分のUIDを入れているので、それを条件にする。
      //   Cloud Functions からの作成は管理者権限なのでこの条件を通る。
      allow create:         if isSignedIn()
                              && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.toUserId == request.auth.uid;
    }

    // ---- フレンド申請 ----
    match /friendRequests/{reqId} {
      allow read:           if isSignedIn()
                              && (resource.data.toId == request.auth.uid
                                  || resource.data.formId == request.auth.uid);
      // ⚠️ 2026-10-17 修正。
      //   以前はログインしていれば誰でも、送信者（formId）を偽ったフレンド申請を作れた。
      //   アプリ側で申請を作る3か所はすべて自分のUIDを入れているので、それを条件にする。
      allow create:         if isSignedIn()
                              && request.resource.data.formId == request.auth.uid;
      // ⚠️ 2026-10-17 修正。申請の更新（承認済みにする等）は受け取った人だけ。
      //   取り消し・拒否の削除は、送った側・受け取った側のどちらもできる（今までどおり）。
      allow update:         if isSignedIn() && resource.data.toId == request.auth.uid;
      allow delete:         if isSignedIn()
                              && (resource.data.toId == request.auth.uid
                                  || resource.data.formId == request.auth.uid);
    }

    // ---- 承認・拒否の履歴（本人のみ読める / 1つの判断で自分の行と相手の行を書く） ----
    // ⚠️ 2026-10-17 修正。以前はログインしていれば誰でも、誰の履歴にでも行を作れた。
    //   「書いた人（byUid）が自分」であることを必須にする。相手の行も書く作りなので
    //   偽の行を完全には防げないが、誰が書いたかは必ず残る（完全に防ぐ作り替えは別途）。
    match /approvalHistory/{id} {
      allow read:           if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create:         if isSignedIn() && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- 会話スレッド（件ごとのメッセージ・その件の当事者のみ） ----
    match /threads/{threadId} {
      // ⚠️ 2026-09-18 修正。
      //   まだ無いスレッドを読むと resource が null になり、参加者の判定でエラーになって
      //   拒否されていた。立て替えのグループチャットは「読んでから書く」作りなので、
      //   この読み取りで止まり、**チャットが一度も作られていなかった**。
      //   無い文書の読み取りだけ通す（中身は何も返らない）。一覧の取得には影響しない。
      allow read:   if isSignedIn()
                      && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      // ⚠️ 2026-09-18 修正。
      //   以前は「自分を participants に入れて更新すれば通る」ため、スレッドIDを知っていれば
      //   誰でも自分を足して会話を読めた。アプリ側に後から参加者を足す処理は無いので外す。
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read, create, update: if isSignedIn()
          && exists(/databases/$(database)/documents/threads/$(threadId))
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
      }
    }
  }
}
